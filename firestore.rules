rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /registrations/{docId} {

      // Anyone can CREATE a new registration (form submission)
      allow create: if
        request.resource.data.ticketId is string &&
        request.resource.data.ticketId.size() > 0 &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 11 &&
        request.resource.data.batchYear is string &&
        request.resource.data.batchYear.size() == 4 &&
        request.resource.data.bkashTxId is string &&
        request.resource.data.bkashTxId.size() >= 6 &&
        request.resource.data.bkashPhone is string &&
        request.resource.data.bkashPhone.size() >= 11 &&
        request.resource.data.status == 'pending_verification' &&
        request.resource.data.seats is int &&
        request.resource.data.seats >= 1 &&
        request.resource.data.seats <= 10 &&
        request.resource.data.totalAmount is number &&
        request.resource.data.totalAmount > 0;

      // Allow read + status update from the admin dashboard (client-side)
      // The admin page is PIN-protected in the UI.
      // TODO: Replace with Firebase Auth for production.
      allow read: if true;

      // Only allow updating the `status` field (mark as confirmed)
      allow update: if
        request.resource.data.status is string &&
        (request.resource.data.status == 'confirmed' || request.resource.data.status == 'pending_verification') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
